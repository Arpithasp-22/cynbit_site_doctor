# Example secrets file for Streamlit Community Cloud
# Copy this to .streamlit/secrets.toml locally for development
# On Streamlit Cloud, add these secrets in the app settings

# Optional: Anthropic API key for LLM features
# The app works without this - it will fall back to extractive text
# ANTHROPIC_API_KEY = "your-api-key-here"

# Optional: Override the default Claude model
# CLAUDE_MODEL = "claude-sonnet-5-5"
